# ============================================
# UVL Photo Project - Полный пример конфигурации
# ============================================
# Скопируйте этот файл в .env и настройте под вашу систему:
# cp env.example .env
#
# Затем отредактируйте .env и установите нужные значения
# ============================================

# ============================================
# ОБЩИЕ ПАРАМЕТРЫ
# ============================================

# ID дрона (используется для идентификации в системе)
DRONE_ID=00

# Доменное имя для доступа к dashboard (например: uvl-photo.local)
# Если указано, будет использоваться вместо IP адреса для отображения в интерфейсе
# Для работы требуется настройка DNS или mDNS (выполняется скриптом tools/setup-dns.sh)
# Раскомментируйте и укажите, если нужно:
# DASHBOARD_HOSTNAME=uvl-photo.local

# ============================================
# MAVLink НАСТРОЙКИ
# ============================================

# Путь к последовательному порту MAVLink (обычно /dev/ttyACM0 или /dev/ttyUSB0)
MAVLINK_SERIAL_PATH=/dev/ttyACM0

# Скорость порта MAVLink (обычно 57600 или 115200)
MAVLINK_SERIAL_BAUD=57600

# ID системы MAVLink (обычно 1)
MAVLINK_SYSTEM_ID=1

# Включить UDP для MAVLink (true/false)
# Позволяет подключаться через Mission Planner по сети
# Раскомментируйте, если нужно подключение через UDP:
# MAVLINK_UDP_EN=true
MAVLINK_UDP_EN=false

# Хост UDP для MAVLink (0.0.0.0 = все интерфейсы)
MAVLINK_UDP_HOST=0.0.0.0

# Порт UDP для MAVLink (стандартный порт Mission Planner)
MAVLINK_UDP_PORT=14550

# ============================================
# СКАНЕР И OSD (On-Screen Display)
# ============================================

# Путь к последовательному порту сканера
SCANNER_SERIAL_PATH=/dev/ttyAMA0

# Скорость порта сканера
SCANNER_SERIAL_BAUD=115200

# Таймаут переподключения сканера в миллисекундах (0 = отключено)
SCANNER_SERIAL_RECONNECT_TIMEOUT=0

# Путь к последовательному порту OSD (если не указан, используется SCANNER_SERIAL_PATH)
OSD_SERIAL_PATH=/dev/ttyAMA0

# Скорость порта OSD (если не указана, используется SCANNER_SERIAL_BAUD)
OSD_SERIAL_BAUD=115200

# Размеры экрана OSD (в символах)
OSD_WIDTH=30
OSD_HEIGHT=16

# Отступы OSD (в символах)
OSD_PADDING_TOP=1
OSD_PADDING_BOTTOM=5
OSD_PADDING_LEFT=2
OSD_PADDING_RIGHT=2

# ============================================
# RC КАНАЛЫ (Radio Control)
# ============================================

# Номера RC каналов для различных кнопок
RC_EMPTY_CH=6
RC_RESCAN_CH=6
RC_NO_TAG_CH=6
RC_UNREADABLE_CH=6
RC_PHOTO_CH=7
RC_SCANOFF_CH=8
RC_ALLEY_SWITCH_CH=9

# PWM значения для RC каналов (значения при нажатии кнопок)
RC_EMPTY_PWM=1067
RC_RESCAN_PWM=1249
RC_NO_TAG_PWM=1495
RC_UNREADABLE_PWM=982
RC_PHOTO_PWM=2006
RC_SCANOFF_PWM=2006
RC_ALLEY_NEXT_PWM=1025
RC_ALLEY_PREV_PWM=1075

# ============================================
# КАМЕРА И ФОТОГРАФИРОВАНИЕ
# ============================================

# Включить камеру (true/false)
# ОБЯЗАТЕЛЬНО установите в true для работы фотографирования
CAMERA_EN=false

# Разрешение фотографий (пиксели)
PHOTO_WIDTH=2028
PHOTO_HEIGHT=1520

# Частота кадров камеры (FPS)
CAMERA_FRAMERATE=10

# Ориентация EXIF (1-8)
# Для значений см. http://www.cipa.jp/std/documents/e/DC-008-2012_E.pdf
PHOTO_EXIF_ORIENTATION=6

# Таймаут камеры в миллисекундах (0 = бесконечно)
CAMERA_TIMEOUT=0

# ============================================
# НАСТРОЙКИ ЭКСПОЗИЦИИ КАМЕРЫ
# ============================================

# Выдержка в микросекундах (0 = автоматическая, максимум 100000000)
# Примеры:
#   0 = автоматическая
#   10000 = 10 миллисекунд
#   50000 = 50 миллисекунд
CAMERA_SHUTTER=0

# Усиление gain (0 = автоматическая, диапазон 0-16)
# Примеры:
#   0 = автоматическая
#   2 = низкое усиление
#   8 = среднее усиление
#   16 = максимальное усиление
CAMERA_GAIN=0

# Режим экспозиции (normal, short, long)
CAMERA_EXPOSURE=normal

# Режим замера экспозиции (centre, spot, matrix, custom)
CAMERA_METERING=centre

# Баланс белого (auto, incandescent, tungsten, fluorescent, indoor, daylight, cloudy, custom)
CAMERA_AWB=auto

# ============================================
# НАСТРОЙКИ ИЗОБРАЖЕНИЯ КАМЕРЫ
# ============================================

# Яркость (-1.0 до 1.0)
# Примеры:
#   -1.0 = очень темно
#   0 = нормально
#   1.0 = очень ярко
CAMERA_BRIGHTNESS=0

# Контраст (0.0 до 2.0)
# Примеры:
#   0.0 = нет контраста
#   1.0 = нормальный контраст
#   2.0 = максимальный контраст
CAMERA_CONTRAST=1.0

# Насыщенность (0.0 до 2.0)
# Примеры:
#   0.0 = черно-белое
#   1.0 = нормальная насыщенность
#   2.0 = максимальная насыщенность
CAMERA_SATURATION=1.0

# Резкость (0.0 до 2.0)
# Примеры:
#   0.0 = мягкое изображение
#   1.0 = нормальная резкость
#   2.0 = максимальная резкость
CAMERA_SHARPNESS=1.0

# ============================================
# СОХРАНЕНИЕ ФОТОГРАФИЙ
# ============================================

# Включить сохранение фотографий на диск (true/false)
PHOTO_SAVE_ENABLED=false

# Директория для сохранения фотографий (создаётся автоматически, если не существует)
PHOTO_SAVE_DIR=./photos

# ============================================
# ПРОТОКОЛ (для совместимости, обычно не используется)
# ============================================

# Порт TCP сервера протокола mintt
MINTT_PORT=55757

# Хост TCP сервера протокола mintt
MINTT_HOST=0.0.0.0

# ============================================
# ПРИМЕЧАНИЯ
# ============================================
#
# 1. Все параметры опциональны и имеют значения по умолчанию
# 2. Параметры камеры можно изменять динамически через веб-интерфейс dashboard
# 3. Изменения параметров камеры сохраняются в файл camera-config.json
# 4. Для работы с камерой обязательно установите CAMERA_EN=true
# 5. Для подключения через Mission Planner установите MAVLINK_UDP_EN=true
# 6. Подробная документация: docs/ru/env-variables.md
#

