# Основные настройки
DRONE_ID=00

# MAVLink
MAVLINK_SERIAL_PATH=/dev/ttyACM0
MAVLINK_SERIAL_BAUD=57600
MAVLINK_SYSTEM_ID=1
MAVLINK_UDP_EN=true

# OSD
OSD_SERIAL_PATH=/dev/ttyS0
OSD_SERIAL_BAUD=115200
OSD_WIDTH=30
OSD_HEIGHT=16

# Камера (ОБЯЗАТЕЛЬНО для фото-режима!)
CAMERA_EN=true
PHOTO_WIDTH=3280
PHOTO_HEIGHT=2464
PHOTO_EXIF_ORIENTATION=6
CAMERA_TIMEOUT=0
CAMERA_FRAMERATE=10

# Сохранение фотографий на диск
PHOTO_SAVE_ENABLED=true      # Включить сохранение фотографий на диск
PHOTO_SAVE_DIR=./photos      # Директория для сохранения (создаётся автоматически)
# RC канал для фотографирования
RC_PHOTO_CH=6
RC_PHOTO_PWM=1500

# Протокол (можно оставить по умолчанию)
MINTT_PORT=55757
MINTT_HOST=0.0.0.0

# Доменное имя для доступа к dashboard
DASHBOARD_HOSTNAME=uvl-photo.local
