{
  "project": {
    "name": "uvl-photo-project",
    "version": "7.4.0",
    "description": "Бортовой софт для дрона на Raspberry Pi для фотографирования по нажатию кнопки",
    "platform": "Raspberry Pi",
    "language": "JavaScript (Node.js)"
  },
  "documentation": {
    "primary_reference": "ARCHITECTURE_LLM.json",
    "human_readable": "ARCHITECTURE.md",
    "rule": "При работе над проектом необходимо ориентироваться на ARCHITECTURE_LLM.json как на основной справочник. При каждом изменении архитектуры, добавлении новых модулей, функций или переменных - обязательно обновлять ARCHITECTURE_LLM.json. Этот файл используется LLM-ассистентами для понимания структуры проекта без необходимости анализа всего кода."
  },
  "entry_point": "index.js",
  "architecture": {
    "main_components": [
      {
        "name": "index.js",
        "type": "main",
        "purpose": "Точка входа, инициализация всех компонентов",
        "dependencies": [
          "mavlink/system.js",
          "protocol.js",
          "dashboard.js",
          "osd.js",
          "ui.js",
          "photo.js",
          "rc.js",
          "adapters.js"
        ],
        "key_variables": {
          "droneId": "ID дрона из переменных окружения",
          "mavlinkSerialPath": "Путь к последовательному порту MAVLink",
          "osdPath": "Путь к последовательному порту OSD",
          "photoCounter": "Счётчик фотографий для генерации уникальных ID",
          "droneIp": "Текущий IP адрес интерфейса wlan0, обновляется каждую секунду и передается в dashboard"
        },
        "key_functions": {
          "getIp": "Получение IP адреса интерфейса wlan0",
          "connectionStatus": "Определение статуса подключения (лицензия, MAVLink, IP)",
          "handleButton": "Обработка нажатий кнопок для отображения на OSD",
          "showInfoMessage": "Отображение информационного сообщения на OSD"
        },
        "data_flows": [
          {
            "from": "rc_channels",
            "to": "photo",
            "description": "Каналы управления парсятся, кнопка PHOTO вызывает прямое фотографирование"
          },
          {
            "from": "mavlink_heartbeat",
            "to": "status",
            "description": "Heartbeat от полётного контроллера используется для определения статуса подключения"
          },
          {
            "from": "photo_button",
            "to": "camera",
            "description": "Нажатие кнопки PHOTO вызывает takePhoto() напрямую без ожидания запроса"
          }
        ]
      },
      {
        "name": "mavlink/",
        "type": "module",
        "purpose": "Работа с протоколом MAVLink",
        "files": [
          {
            "name": "system.js",
            "class": "MavSystem",
            "extends": "EventEmitter",
            "key_methods": {
              "send": "Отправка MAVLink сообщения",
              "connect": "Создание адаптера для подключения внешних систем",
              "subscribeTo": "Подписка на MAVLink сообщение",
              "setMessageInterval": "Установка интервала отправки сообщения",
              "getMission": "Получение миссии с полётного контроллера",
              "setMission": "Установка миссии на полётный контроллер",
              "arm": "Включение арматуры",
              "disarm": "Выключение арматуры",
              "takeOff": "Взлёт на заданную высоту",
              "land": "Посадка",
              "flyto": "Полёт к точке",
              "setYaw": "Установка курса",
              "heartbeat": "Отправка heartbeat сообщения"
            },
            "key_events": {
              "heartbeat": "Получен heartbeat от полётного контроллера",
              "rc_channels": "Получены данные RC каналов",
              "message": "Получено любое MAVLink сообщение"
            }
          },
          {
            "name": "impl.js",
            "purpose": "Реализация парсинга и обработки MAVLink сообщений",
            "exports": {
              "mav2": "Объект с константами и сообщениями MAVLink 2.0",
              "MAVLink20Processor": "Класс для обработки MAVLink 2.0 сообщений",
              "parse": "Функция парсинга буфера MAVLink сообщений",
              "apm": "Константы режимов ArduPilot"
            }
          },
          {
            "name": "mission.js",
            "purpose": "Работа с миссиями MAVLink",
            "classes": [
              {
                "name": "MavMissionItem",
                "methods": ["fromMavMessage", "fromQGCPlanItem", "mavMessage", "fromPoint", "isEqual"]
              },
              {
                "name": "MavMission",
                "methods": ["fromMavMessages", "fromQGCPlan", "toJSON", "mavMessages", "fromPoints", "asCoordinates", "isEqual"]
              }
            ]
          },
          {
            "name": "geo.js",
            "purpose": "Географические вычисления",
            "functions": {
              "global_distance": "Вычисление расстояния между двумя точками (формула гаверсинуса)",
              "find_closest": "Поиск ближайшей точки",
              "destination": "Вычисление точки назначения по смещению"
            }
          }
        ]
      },
      {
        "name": "protocol.js",
        "type": "module",
        "purpose": "Протокол связи (mintt) - оставлен для совместимости, но больше не используется для основной функциональности",
        "class": "Protocol",
        "extends": "EventEmitter",
        "key_methods": {
          "send": "Отправка сообщения всем подключённым клиентам",
          "hasConnections": "Проверка наличия подключённых клиентов"
        },
        "message_format": "mintt:topic?param1=value1&param2=value2\\r\\n[body data]",
        "note": "Протокол больше не используется для связи с Python модулем, так как Python модуль удалён"
      },
      {
        "name": "dashboard.js",
        "type": "module",
        "purpose": "Веб-интерфейс для мониторинга и управления фотографиями",
        "class": "Dashboard",
        "extends": "EventEmitter",
        "services": {
          "http": {
            "port": 8080,
            "purpose": "Статические файлы из dashboard-public/"
          },
          "websocket": {
            "port": 8081,
            "purpose": "Двусторонняя связь с клиентами"
          }
        },
        "key_methods": {
          "setState": "Установка состояния (поддерживает lodash пути)",
          "log": "Логирование в дашборд"
        },
        "state_variables": {
          "droneIp": "Текущий IP адрес Raspberry Pi (обновляется автоматически)",
          "mavlinkUdpConnected": "Статус подключения через MAVLink UDP (true/false)",
          "mavlinkUdpClientIp": "IP адрес подключенного клиента через MAVLink UDP",
          "lastPhoto": "Информация о последней сделанной фотографии (id, timestamp, saved, path)",
          "cameraSettings": "Настройки камеры (width, height, exifOrientation, saveEnabled, saveDir)"
        },
        "websocket_commands": {
          "getLastPhoto": "Запрос последней фотографии (отправляет base64 изображение)",
          "downloadPhotosArchive": "Создание и отправка ZIP архива со всеми фотографиями",
          "getCameraSettings": "Получение текущих настроек камеры",
          "updateCameraSettings": "Обновление настроек камеры (JSON в payload)",
          "reloadCamera": "Перезагрузка камеры с новыми настройками",
          "deleteAllPhotos": "Удаление всех сохраненных фотографий"
        },
        "events": [
          "timestamp"
        ]
      },
      {
        "name": "osd.js",
        "type": "module",
        "purpose": "Рендеринг OSD (On-Screen Display) для отправки на полётный контроллер",
        "key_functions": {
          "renderElement": "Рендеринг одного элемента OSD",
          "renderElements": "Рендеринг массива элементов",
          "posX": "Вычисление X координаты (поддержка 'left', 'right', 'center', числа)",
          "posY": "Вычисление Y координаты (поддержка 'top', 'bottom', 'center', числа)",
          "setGeometry": "Установка геометрии экрана OSD"
        },
        "element_format": "[0x55, 0x49, elem, y, x, length, ...data]",
        "geometry": {
          "width": "Ширина экрана OSD",
          "height": "Высота экрана OSD",
          "paddingTop": "Верхний отступ",
          "paddingBottom": "Нижний отступ",
          "paddingRight": "Правый отступ",
          "paddingLeft": "Левый отступ"
        }
      },
      {
        "name": "ui.js",
        "type": "module",
        "purpose": "Управление UI элементами OSD",
        "key_functions": {
          "configure": "Настройка функции записи и геометрии",
          "updateLayout": "Обновление макета элементов",
          "update": "Обновление состояния элемента",
          "render": "Рендеринг всех элементов (с debounce 100ms)"
        },
        "workflow": [
          "Элементы регистрируются через updateLayout() с функцией рендеринга",
          "Состояние обновляется через update()",
          "Рендеринг происходит автоматически с debounce",
          "Изменения отправляются через функцию write (обычно osdSp.write)"
        ]
      },
      {
        "name": "photo.js",
        "type": "module",
        "purpose": "Управление камерой и съёмка фотографий",
        "key_functions": {
          "takePhoto": "Съёмка фотографии с применением EXIF поворота. Принимает id и callback, возвращает JPEG данные или ошибку. Если включено сохранение (PHOTO_SAVE_ENABLED=true), сохраняет фотографию на диск в директорию PHOTO_SAVE_DIR",
          "getCameraSettings": "Получение текущих настроек камеры (width, height, exifOrientation, saveEnabled, saveDir)",
          "updateCameraSettings": "Обновление настроек камеры. Принимает объект с настройками, обновляет переменные окружения и возвращает обновленные настройки",
          "reloadCamera": "Перезагрузка камеры с текущими настройками. Создает новый экземпляр LibcameravidJPEGStream",
          "getPhotoList": "Получение списка всех сохраненных фотографий. Возвращает массив объектов с информацией о файлах (filename, path, size, mtime), отсортированный по времени изменения (новые первыми)",
          "deleteAllPhotos": "Удаление всех сохраненных фотографий из директории. Возвращает объект {deleted: число, error: строка или null}"
        },
        "dependencies": ["camera.js", "piexifjs"],
        "key_variables": {
          "photoWidth": "Ширина фотографии из PHOTO_WIDTH (можно изменять динамически)",
          "photoHeight": "Высота фотографии из PHOTO_HEIGHT (можно изменять динамически)",
          "photoExifOrientation": "Ориентация EXIF из PHOTO_EXIF_ORIENTATION (можно изменять динамически)",
          "photoSaveEnabled": "Флаг включения сохранения на диск из PHOTO_SAVE_ENABLED (можно изменять динамически)",
          "photoSaveDir": "Директория для сохранения фотографий из PHOTO_SAVE_DIR (можно изменять динамически)",
          "camera": "Экземпляр LibcameravidJPEGStream (пересоздается при перезагрузке)",
          "cameraError": "Флаг ошибки камеры"
        }
      },
      {
        "name": "camera.js",
        "type": "module",
        "purpose": "Обёртка над libcamera-vid для работы с камерой Raspberry Pi",
        "key_functions": {
          "Libcameravid": "Запуск libcamera-vid процесса с настраиваемыми параметрами",
          "LibcameravidJPEGStream": "Поток JPEG кадров из libcamera-vid с настройками из конфигов"
        },
        "configurable_parameters": {
          "width": "Ширина кадра (из options или по умолчанию 640)",
          "height": "Высота кадра (из options или по умолчанию 480)",
          "timeout": "Таймаут камеры из CAMERA_TIMEOUT (по умолчанию 0 - бесконечно)",
          "framerate": "Частота кадров из CAMERA_FRAMERATE (по умолчанию 10)",
          "codec": "Кодек (всегда MJPEG)"
        }
      },
      {
        "name": "rc.js",
        "type": "module",
        "purpose": "Обработка RC (Radio Control) каналов",
        "key_functions": {
          "checkButton": "Проверка нажатия кнопки на RC канале с debounce"
        },
        "parameters": {
          "msg": "Сообщение RC_CHANNELS",
          "ch": "Номер канала",
          "ideal": "Идеальное значение PWM",
          "label": "Метка кнопки",
          "cbOn": "Callback при нажатии",
          "cbOff": "Callback при отпускании"
        }
      },
      {
        "name": "adapters.js",
        "type": "module",
        "purpose": "Адаптеры для подключения внешних систем",
        "key_functions": {
          "udp": "Создание UDP адаптера. Работает в режиме 'ответ на запрос': слушает на указанном host:port, запоминает адрес первого отправителя и отправляет ответы только на этот адрес. Параметры: host (по умолчанию 0.0.0.0 - все интерфейсы), port, callback для уведомления о подключении",
          "connect": "Соединение двух адаптеров",
          "connectSync": "Синхронное соединение адаптеров"
        },
        "udp_behavior": {
          "mode": "ответ на запрос",
          "description": "UDP адаптер запоминает адрес первого отправителя (rinfo) и отправляет все ответы только на этот адрес. Это означает, что клиент (например, Mission Planner) должен первым отправить запрос на Raspberry Pi",
          "default_port": 14550,
          "default_host": "0.0.0.0 (все интерфейсы)"
        }
      },
      {
        "name": "utils.js",
        "type": "module",
        "purpose": "Вспомогательные утилиты",
        "key_functions": [
          "log",
          "parseJson",
          "paseUrl",
          "shallowEqual",
          "shallowEqualAll",
          "once",
          "subscribe",
          "repeatRetryUntilTimeout",
          "debounce",
          "unbitmap_k",
          "unbitmap_v",
          "paramsJoin",
          "getFiles",
          "fsExists"
        ]
      },
    ]
  },
  "data_flows": [
    {
      "id": "rc_to_photo",
      "description": "RC Channels → Фотографирование",
      "path": [
        "MAVLink RC_CHANNELS",
        "mavSystem.on('rc_channels')",
        "checkButton() для RC_PHOTO_CH",
        "takePhoto(photoId, callback)",
        "camera.once('data')",
        "exifRotate()",
        "Если PHOTO_SAVE_ENABLED=true: writeFileSync() в PHOTO_SAVE_DIR",
        "showInfoMessage() / dashboard.setState('lastPhoto')"
      ]
    },
    {
      "id": "heartbeat_to_status",
      "description": "MAVLink Heartbeat → Статус",
      "path": [
        "Полётный контроллер",
        "Serial Port (MAVLink)",
        "mavSystem.on('heartbeat')",
        "mavlinkHeartbeat = true",
        "connectionStatus()",
        "ui.update('connection', status)"
      ]
    }
  ],
