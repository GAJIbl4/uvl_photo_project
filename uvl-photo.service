[Unit]
Description=UVL Photo Project - Система автоматического фотографирования с Ardupilot
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/uvl_photo_project

# Запуск через Node.js
ExecStart=/usr/bin/node /home/pi/uvl_photo_project/index.js

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Окружение
Environment="NODE_ENV=production"
Environment="PYTHONUNBUFFERED=1"

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

# Права доступа к USB и камере
SupplementaryGroups=dialout video

[Install]
WantedBy=multi-user.target
