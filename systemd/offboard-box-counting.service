[Unit]
Description=UVL Inventory Offboard service
Wants=network-online.target
After=network-online.target box-counting.service

[Service]
ExecStart=/home/pi/uvl-inventory-offboard/systemd/offboard-box-counting.service.sh
TimeoutStopSec=5s
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
